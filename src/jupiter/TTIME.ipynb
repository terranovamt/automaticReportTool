    "# IMPORT\n",
    "import os\n",
    "import json\n",
    "import shutil\n",
    "import datetime\n",
    "import warnings\n",
    "import numpy as np\n",
    "# import qgrid as qg\n",
    "import polars as pl\n",
    "import pandas as pd\n",
    "import plotly.io as pio\n",
    "import plotly_express as px\n",
    "import ipywidgets as widgets\n",
    "import matplotlib.pyplot as plt\n",
    "import plotly.graph_objects as go\n",
    "\n",
    "from scipy.stats import kurtosis\n",
    "from plotly.subplots import make_subplots\n",
    "from IPython.display import Markdown, display, HTML\n",
    "from pandas.errors import EmptyDataError, ParserError\n",
    "\n",
    "import utility as uty\n",
    "\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore', category=RuntimeWarning)\n",
    "\n",
    "plt.rcParams[\"figure.figsize\"] = [16, 9]\n",
    "read_from_stdf = False\n",
    "pd.set_option(\"display.max_columns\", None)\n",
    "pio.renderers.default = \"notebook\"\n",
    "last_timestamp = datetime.datetime.now()\n",
    "STblue = \"#03234B\"\n",
    "STcyan = \"#3CB4E6\"\n",
    "STred = \"#E6007E\"\n",
    "STyellow = \"#FFD200\"\n",
    "STgreen = \"#49B170\"\n",
    "STViolet = \"#8C0078\"\n",
    "STdarkgreen = \"#04572F\"\n",
    "STcolors = [STblue, STcyan, STyellow, STred, STgreen, STViolet, STdarkgreen]\n",
    "STHBIN = [STgreen, STblue, STcyan, STyellow, STred, STViolet, STdarkgreen]\n",
    "gradientcolor = [STblue, STcyan, STyellow, STred]\n",
    "tempSTcolort8 = [\n",
    "    STblue,\n",
    "    STcyan,\n",
    "    STgreen,\n",
    "    \"#A4C238\",\n",
    "    STyellow,\n",
    "    \"#F3693F\",\n",
    "    STred,\n",
    "]\n",
    "tempSTcolort = [STblue, STcyan, \"#43B3AB\", STgreen, STyellow, \"#F3693F\", STred]\n",
    "STPalette = {\n",
    "    \"-40\": STblue,\n",
    "    \"-10\": STcyan,\n",
    "    \"0\": \"#43B3AB\",\n",
    "    \"30\": STgreen,\n",
    "    \"60\": STyellow,\n",
    "    \"90\": \"#F3693F\",\n",
    "    \"110\": STred,\n",
    "}\n",
    "\n",
    "p = os.listdir()\n",
    "stdflist = []\n",
    "for i in p:\n",
    "    if \"cfg.json\" in i:\n",
    "        try:\n",
    "            with open(i, \"r\") as file:\n",
    "                content = file.read()\n",
    "                if not content.strip():\n",
    "                    raise ValueError(f\"The file {i} is empty.\")\n",
    "                parameter = json.loads(content)\n",
    "            \n",
    "        except FileNotFoundError:\n",
    "            print(f\"File {i} not found.\")\n",
    "        except json.JSONDecodeError as e:\n",
    "            print(f\"Error decoding JSON from file {i}: {e}\")\n",
    "        except KeyError as e:\n",
    "            print(f\"Missing key in JSON data from file {i}: {e}\")\n",
    "        except ValueError as e:\n",
    "            print(e)\n",
    "            \n"
   ]
