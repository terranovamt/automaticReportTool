    "<script>\n",
    "window.addEventListener('load', function() {\n",
    "    var loading = document.querySelector('.loading');\n",
    "    loading.style.display = 'none';\n",
    "    });\n",
    "// alert(\"Hello, world!\");\n",
    "let calcScrollValue = () => {\n",
    "    let scrollProgress = document.getElementById(\"progress\");\n",
    "    let progressValue = document.getElementById(\"progress-value\");\n",
    "    let pos = document.documentElement.scrollTop;\n",
    "    let calcHeight =\n",
    "    document.documentElement.scrollHeight -\n",
    "    document.getElementById(\"TableOfContent\").offsetTop - 10;\n",
    "    let scrollValue = Math.round(((pos - document.getElementById(\"TableOfContent\").offsetTop) * 100) / calcHeight)+5;\n",
    "    if (pos > 100) {\n",
    "    scrollProgress.style.display = \"grid\";\n",
    "    } else {\n",
    "    scrollProgress.style.display = \"none\";\n",
    "    }\n",
    "    scrollProgress.addEventListener(\"click\", () => {\n",
    "    let tableOfContent = document.getElementById(\"TableOfContent\");\n",
    "    tableOfContent.scrollIntoView({ behavior: \"smooth\" });\n",
    "    });\n",
    "    scrollProgress.style.background = `conic-gradient(#03234B ${scrollValue}%, #d7d7d7 ${scrollValue}%)`;\n",
    "};\n",
    "\n",
    "let tableOfContent = document.getElementById(\"TableOfContent\");\n",
    "\n",
    "let observer = new IntersectionObserver((entries) => {\n",
    "    if (entries[0].isIntersecting) {\n",
    "    window.onscroll = calcScrollValue;\n",
    "    window.onload = calcScrollValue;\n",
    "    }\n",
    "});\n",
    "\n",
    "observer.observe(tableOfContent);\n",
    "</script>\n"
   ]
  }
