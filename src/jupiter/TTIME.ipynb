   "source": [
    "#PTR\n",
    "pv_dict = {}\n",
    "td_filtered  = pd.DataFrame()\n",
    "\n",
    "\n",
    "\n",
    "if not ttime.empty:\n",
    "    uty.write_log(\"Start PTR data analysis\")\n",
    "\n",
    "    for tname in ttimetname:\n",
    "        td_clampsmin = pd.DataFrame()\n",
    "        td_clampsmax = pd.DataFrame()\n",
    "        \n",
    "        display(\n",
    "            Markdown(\n",
    "                \"<a id='\"\n",
    "                + tname\n",
    "                + \"'></a><p style='text-align:right;color:red'>ST Restricted</p>\"\n",
    "            )\n",
    "        )\n",
    "\n",
    "        display(Markdown(\"### \" + tname))\n",
    "        display(Markdown(\"---\"))\n",
    "\n",
    "        td = pd.DataFrame(ttime[(ttime[\"TestName\"] == tname)])\n",
    "        td.rename(\n",
    "            columns={\n",
    "                \"max\": \"Max\",\n",
    "                \"min\": \"Min\",\n",
    "                \"mean\": \"Mean\",\n",
    "                \"std\": \"Std\",\n",
    "                \"size\": \"Tested Part\",\n",
    "                \"COM\": \"Composite\",\n",
    "                \"WAFER\": \"Wafer\",\n",
    "                \"X_COORD\": \"XId\",\n",
    "                \"Y_COORD\": \"YId\",\n",
    "            },\n",
    "            inplace=True,\n",
    "        )\n",
    "        # print(td.groupby(\"TestName\")[\"RES_SCAL\"].unique())\n",
    "\n",
    "        # print(td.columns)\n",
    "        td[\"°C\"] = td[\"°C\"].astype(\"str\")\n",
    "        td[\"Unit\"] = td[\"Unit\"].fillna(\"mS\")\n",
    "        td[\"Unit\"] = td[\"Unit\"].replace(\"Knan\", \"S\")\n",
    "        \n",
    "        unique_temperatures = td[\"°C\"].unique()\n",
    "\n",
    "        if len(unique_temperatures) > 1:\n",
    "            # Se ci sono più temperature, prendi i dati per la temperatura 30°C\n",
    "            ul = td.loc[td[\"°C\"] == \"30\", \"High Limit\"].unique()[0]\n",
    "            ll = td.loc[td[\"°C\"] == \"30\", \"Low Limit\"].unique()[0]\n",
    "            units = td.loc[td[\"°C\"] == \"30\", \"Unit\"].unique()[0]\n",
    "        else:\n",
    "            # Se c'è solo una temperatura, prendi i dati per quella temperatura\n",
    "            ul = td[\"High Limit\"].unique()[0]\n",
    "            ll = td[\"Low Limit\"].unique()[0]\n",
    "            units = td[\"Unit\"].unique()[0]\n",
    "            \n",
    "        del unique_temperatures\n",
    "\n",
    "        # Filtering the data for the current combination\n",
    "        minvalue = td[\"Value\"].min()\n",
    "        meanvalue = td[\"Value\"].mean()\n",
    "        medianvalue = td[\"Value\"].median()\n",
    "        maxvalue = td[\"Value\"].max()\n",
    "\n",
    "        # Update statistical\n",
    "        pv = pd.DataFrame(\n",
    "            td[\"Value\"].agg([\"size\", \"min\", \"max\", \"mean\", \"std\"]).round(3)\n",
    "        ).transpose()\n",
    "        \n",
    "        pv[\"unit\"] = units\n",
    "\n",
    "        if pd.unique(td.pltype)[0] == \"BPLTEMP\":\n",
    "\n",
    "            fig = px.histogram(\n",
    "                td[[\"Value\" ,\"XId\", \"YId\"]],\n",
    "                x=\"Value\",\n",
    "                marginal=\"box\",  # or violin, rug\n",
    "                hover_data=td[[\"Value\" ,\"XId\", \"YId\"]],\n",
    "                barmode=\"overlay\",\n",
    "                template=\"plotly_white\",\n",
    "                color_discrete_sequence=tempSTcolort,\n",
    "            )\n",
    "\n",
    "            if ul != 0 and ll != 0:\n",
    "                fig.add_vline(ul, line_color=STred, line_dash=\"dash\")\n",
    "                fig.add_vline(ll, line_color=STred, line_dash=\"dash\")\n",
    "            \n",
    "            if abs(maxvalue - minvalue) < 1 and ul == 0 and ll == 0:\n",
    "                difference = abs(maxvalue - minvalue)*2\n",
    "                range_min = minvalue - difference\n",
    "                range_max = maxvalue + difference\n",
    "                fig.update_layout(\n",
    "                    xaxis=dict(range=[range_min, range_max])\n",
    "                )\n",
    "\n",
    "            fig.update_layout(\n",
    "                xaxis=dict(title=\"TTime ({})\".format(units)),\n",
    "                height=300,\n",
    "            )\n",
    "\n",
    "\n",
    "            fig.show()\n",
    "            \n",
    "            # Filtrare il DataFrame\n",
    "            filtered_df = ttimecom[ttimecom[\"TestName\"].str.contains(f\"__{tname}\")]\n",
    "            filtered_df.loc[:, 'TestName'] = filtered_df['TestName'].str.split('__').str[0]\n",
    "            \n",
    "            if not filtered_df.empty:\n",
    "                # Calcolare la media della colonna Value per ciascun TestName\n",
    "                filtered_df.loc[:, \"Value\"] = pd.to_numeric(filtered_df[\"Value\"], errors='coerce')\n",
    "                numeric_df = filtered_df.dropna(subset=['Value'])\n",
    "                mean_values = numeric_df.groupby(\"TestName\")[\"Value\"].mean().reset_index()\n",
    "\n",
    "                \n",
    "                # Creare il grafico a barre\n",
    "                trace = go.Bar(\n",
    "                    x=mean_values[\"Value\"],\n",
    "                    y=mean_values[\"TestName\"],\n",
    "                    orientation=\"h\",\n",
    "                    name=\"\",\n",
    "                    text=mean_values[\"Value\"].apply(lambda x: f\"{x:.2f}\"),\n",
    "                    hovertemplate=\"Average: %{x}<br>Composite: %{y}<br>\",\n",
    "                    marker=dict(color=STblue),\n",
    "                )\n",
    "\n",
    "                layout = go.Layout(\n",
    "                    yaxis=dict(title=\"\"),\n",
    "                    xaxis=dict(\n",
    "                        title=\"Average TTime (mS)\",\n",
    "                        showgrid=True,\n",
    "                        gridcolor=\"lightgray\",\n",
    "                        zeroline=False,\n",
    "                        showticklabels=True,\n",
    "                    ),\n",
    "                    plot_bgcolor=\"white\",\n",
    "                    height=400,\n",
    "                )\n",
    "\n",
    "                fig = go.Figure(data=[trace], layout=layout)\n",
    "                fig.update_traces(hoverlabel=dict(\n",
    "                    font=dict(color=STblue),\n",
    "                    bordercolor=STblue,\n",
    "                    bgcolor=STcyan\n",
    "                ))\n",
    "                fig.update_layout(\n",
    "                    height= (50 * (filtered_df[\"TestName\"].nunique() + 1)+100),\n",
    "                )\n",
    "                fig.show()\n",
    "                \n",
    "\n",
    "        elif pd.unique(td.pltype)[0] == \"test\":\n",
    "            pass\n",
    "\n",
    "        pv.rename(\n",
    "            columns={\n",
    "                \"max\": \"Max\",\n",
    "                \"min\": \"Min\",\n",
    "                \"mean\": \"Mean\",\n",
    "                \"std\": \"Std\",\n",
    "                \"size\": \"Tested Part\",\n",
    "                \"unit\": \"Unit\",\n",
    "            },\n",
    "            inplace=True,\n",
    "        )\n",
    "        pv = pv.fillna(\"-\").replace(\n",
    "            {\n",
    "                np.nan: \"-\",\n",
    "                \" \": \"-\",\n",
    "                \"\": \"-\",\n",
    "                \"nan\": \"-\",\n",
    "                \"NAN\": \"-\",\n",
    "                \"NaN\": \"-\",\n",
    "                \"Nan\": \"-\",\n",
    "            }\n",
    "        )\n",
    "\n",
    "        pv['Tested Part'] = pv['Tested Part'].astype(int)\n",
    "        pv = pv[\n",
    "            [\n",
    "                \"Tested Part\",\n",
    "                \"Min\",\n",
    "                \"Mean\",\n",
    "                \"Max\",\n",
    "                \"Std\",\n",
    "                \"Unit\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        styles = [\n",
    "            {\n",
    "                \"selector\": \"tbody tr + tr th.level0 ~ td ,tbody th.level0 + th.level1 ,tbody th.level0 \",\n",
    "                \"props\": [\n",
    "                    (\"border-top\", \"1px solid #bdbdbd\"),\n",
    "                ],\n",
    "            },\n",
    "        ]\n",
    "\n",
    "        pv_dict[tname] = pv\n",
    "        \n",
    "        def custom_format(x):\n",
    "            if isinstance(x, (int, float)):\n",
    "                if x == int(x):\n",
    "                    return f\"{int(x)}\"\n",
    "                elif round(x, 3) == round(x):\n",
    "                    return f\"{round(x)}\"\n",
    "                else:\n",
    "                    return f\"{x:.3f}\"\n",
    "            return x\n",
    "\n",
    "        pv = (\n",
    "            pv.style.set_properties(subset=[\"Mean\"], **{\"font-weight\": \"bold\"})\n",
    "            .format(custom_format)\n",
    "            .set_table_styles(styles)\n",
    "        )\n",
    "\n",
    "        # Display table\n",
    "        display(pv)\n",
    "\n",
    "        # break\n",
    "        # summary.loc[tname] = pd.Series(\n",
    "        #     {\"Min\": np.min(pv[\"Min\"]), \"Max\": np.max(pv[\"Max\"]), \"Unit\": units}\n",
    "        # )\n",
    "if pv_dict:\n",
    "    # Combina tutti i DataFrame pv in un unico DataFrame statistics\n",
    "    statistics = (\n",
    "        pd.concat(pv_dict, names=[\"TestName\"])\n",
    "        .fillna(0)\n",
    "        .reset_index(level=1, drop=True)\n",
    "        .reset_index()\n",
    "    )\n",
    "    statistics = statistics.map(custom_format)\n",
    "else:\n",
    "    statistics = pd.DataFrame()\n",
    "\n",
    "uty.write_log(\"PTR analysis done\")\n"
   ]
  },
